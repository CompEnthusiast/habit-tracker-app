<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glow Circle Ring -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 26,54"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#6366F1" />
                <item android:offset="0.5" android:color="#A855F7" />
                <item android:offset="1.0" android:color="#06B6D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Habit Checkmark / Streak -->
    <path
        android:pathData="M40,54 L49,63 L69,43"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="40"
                android:startY="63"
                android:endX="69"
                android:endY="43"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="0.6" android:color="#818CF8" />
                <item android:offset="1.0" android:color="#C084FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Star / Sparkle Dot -->
    <path
        android:pathData="M76,32 L78,32 L78,34 L76,34 Z"
        android:fillColor="#38BDF8" />
</vector>
